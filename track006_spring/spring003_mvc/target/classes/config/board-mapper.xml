<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.the703.dao.BoardMapper">
	<insert id="insert" parameterType="com.the703.dto.BoardDto">
		insert into mvcboard2 (bname, bpass, btitle, bcontent, bip) values (#{bname}, #{bpass}, #{btitle}, #{bcontent}, #{bip})
	</insert>
						<!-- mybatis-config.xml (alias) -->
	<update id="update" parameterType="BoardDto">
		update mvcboard2
		set bname=#{bname}, 
			bpass=#{bpass},
			btitle=#{btitle},
			bcontent=#{bcontent},
			<!-- bip=#{bip}, -->
			bhit = bhit + 1
		where bno=#{bno} and bpass=#{bpass};
	</update>
	
		<!-- 메서드명 / 파라미터타입 -->
	<delete id="delete" parameterType="BoardDto">
		delete from mvcboard2 
		where bno=#{bno} and bpass=#{bpass};
	</delete>
	
	<select resultType="BoardDto" id="select" parameterType="int">
		select * from mvcboard2 where bno=#{bno};
	</select>
	
	<select resultType="BoardDto" id="selectAll" >
		select * from mvcboard2 order by bno desc;
	</select>
</mapper>

<!--
insert                 : insert into mvcboard2 (bname, bpass, btitle, bcontent, bip) values (?, ?, ?, ?, ?);
select (전체)           : select * from mvcboard2 order by bno desc;
select (해당번호의 읽기)  : select * from mvcboard2 where bno=?;
update (해당번호 수정)   : update mvcboard2 set btitle=?, bcontent=? where bno=?;
delete (해당번호 삭제)   : delete from mvcboard2 where bno=?;
 -->