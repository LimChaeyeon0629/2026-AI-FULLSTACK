<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.the703.dao.UserInfoMapper">
	<insert id="insert" parameterType="com.the703.dto.UserInfoDto">
		insert into mvcboard2 (bname, bpass, btitle, bcontent) values (${bname}, ${bpass}, ${btitle}, ${bcontent});
	</insert>
	
						<!-- mybatis-config.xml (alias) -->
	<update id="update" parameterType="UserInfoDto">
	</update>
	
		<!-- 메서드명 / 파라미터타입 -->
	<delete id="delete" parameterType="int">
	</delete>
	
	<select resultType="UserInfoDto" id="selectAll" >
	</select>
	
	<select resultType="UserInfoDto" id="select" parameterType="int">
	</select>
</mapper>

<!--
insert                 : insert into mvcboard2 values (?, ?, ?, ?, ?);
select (전체)           : select * from mvcboard2;
select (해당번호의 읽기)  : select * from mvcboard2 where bno=?;
update (해당번호 수정)   : update mvcboard2 set bname=?, bpass=? where bno=?;
delete (해당번호 삭제)   : delete from mvcboard2 where bno=?;
 -->